abort() {
    echo >&2 "$0 ERROR: $@"
    exit 1
}

usercancel()
{ abort "user cancel."
}

passwcheck()
{
pw=''
cpw=''
type=$1

while [ $pw != $cpw ] ||  [ -z $pw ] ||  [ -z $cpw ]; do
	pw=$(dialog --insecure --passwordbox "enter $type password" 0 0 --output-fd 1) || usercancel
	cpw=$(dialog --insecure --passwordbox "confirm $type password" 0 0 --output-fd 1) || usercancel
done
}

