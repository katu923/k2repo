finish()
{
xbps-reconfigure -far /mnt/
}

restart()
{
dialog --yesno "All done! reboot?" 0 0 --output-fd 1
end=$?
clear

if [[ $end == 1 ]]; then
	exit

else
	umount -R /mnt
 	reboot
	shutdown -r now
fi
}

