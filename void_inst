firewall()
{
#firewall nftables example for a workstation

echo -e '

 #!/usr/sbin/nft -f

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        # 1. Interface loopback
        iif "lo" accept

        # 2. Conexões já estabelecidas e relacionadas
        ct state established,related accept

        # 3. Descartar pacotes inválidos
        ct state invalid drop

        # 4. Permitir tráfego da interface do virt-manager (libvirt)
        iifname "virbr*" accept

        # 5. ICMP (IPv4) e ICMPv6 (Essencial para IPv6)
        ip protocol icmp icmp type echo-request limit rate 5/second accept
        ip6 nexthdr icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept

        # 6. Permitir SSH (com registo de log)
        # tcp dport 22 log prefix "NFTABLES-SSH: " accept
		# tcp dport 1714-1764 accept comment "accept KDE Connect functionality"
        # udp dport 1714-1764 accept comment "accept KDE Connect functionality"
        # 7. Registar logs de bloqueios
        log prefix "NFTABLES-DROP: " level warn
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        # Permitir que as VMs acedam à internet e comuniquem entre si
        iifname "virbr*" oifname "virbr*" accept
        iifname "virbr*" accept
        oifname "virbr*" ct state established,related accept
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
} ' > /mnt/etc/nftables.conf

}

