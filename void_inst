hardening()
{
#disable root login
if [[ $adm ==  0 ]]; then
	sed -i 's,^root:x:0:0:root:/root:/bin/bash,root:x:0:0:root:/root:/sbin/nologin,' /mnt/etc/passwd
fi

# harden sysctl

mkdir /mnt/etc/sysctl.d

echo -e "
# Restringe o acesso ao buffer de mensagens do kernel (dmesg) apenas ao root
kernel.dmesg_restrict = 1

# Oculta endereços de ponteiros do kernel em /proc para prevenir exploits de memória
kernel.kptr_restrict = 2

# Restringe o uso de ptrace (evita que um processo intersete ou modifique outro)
kernel.yama.ptrace_scope = 1

# Desativa dumps de memória (core dumps) para binários SUID
fs.suid_dumpable = 0

# Proteção contra ataques de negação de serviço (DoS) via Ctrl-Alt-Del
kernel.ctrl-alt-del = 0

# Ativa a proteção de SYN Cookies para mitigar ataques de SYN Flood
net.ipv4.tcp_syncookies = 1

# Ativa a filtragem de caminho reverso (impede spoofing de IP de origem)
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1

# Ignora redirecionamentos ICMP (previne ataques Man-in-the-Middle)
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0

# Não envia redirecionamentos ICMP (esta máquina não age como um router)
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0

# Rejeita pacotes com roteamento estático na origem (Source Routing)
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0

# Ignora pings direcionados ao endereço de broadcast (previne amplificação DoS)
net.ipv4.icmp_echo_ignore_broadcasts = 1

# Regista pacotes suspeitos (como spoofing, pacotes marcados e redirecionamentos)
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1
" > /mnt/etc/sysctl.d/99-hardening.conf


#doas
echo "permit persist :$username" > /mnt/etc/doas.conf

$crm << EOF
chown -c root:root /etc/doas.conf
chmod -c 0400 /etc/doas.conf
EOF

#ssh / cron hardening permissions
echo -e "
PasswordAuthentication no
PermitRootLogin no
KbdInteractiveAuthentication no
" >> /mnt/etc/ssh/sshd_config

$crm << EOF
chown -c root:root /etc/ssh/sshd_config
chmod -c 0400 /etc/ssh/sshd_config
chown -c root:root /etc/cron.daily
chmod -c 0400 /etc/cron.daily
EOF

#blacklist modules and drivers not needed
echo -e "blacklist dccp
install dccp /bin/false
blacklist sctp
install sctp /bin/false
blacklist rds
install rds /bin/false
blacklist tipc
install tipc /bin/false
blacklist firewire-core
install firewire-core /bin/false
blacklist thunderbolt
install thunderbolt /bin/false" > /mnt/etc/modprobe.d/blacklist.conf

#apparmor

sed -i 's/^#*write-cache/write-cache/i' /mnt/etc/apparmor/parser.conf

}

