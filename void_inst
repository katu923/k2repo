$crm chown $username:$username /mnt/home/$username/.zshrc

#for autologin with agetty1 add --autologin username to /etc/runit/runsvdir/agetty1/conf
}

bootmanag()
{


#uki
if [[ $bm == "uki" ]]; then
	echo "hostonly=yes" > /mnt/etc/dracut.conf.d/10-boot.conf
	echo 'uefi="yes"'  >> /mnt/etc/dracut.conf.d/10-boot.conf
	echo -e "#!/bin/sh
	mv $boot_part_name/EFI/void/linux-*.efi $boot_part_name/EFI/void/void-signed-uki-old.efi" \
	> /mnt/etc/kernel.d/post-install/10-uefi-boot
	chmod +x /mnt/etc/kernel.d/post-install/10-uefi-boot

	echo -e "#!/bin/sh
	cp $boot_part_name/EFI/void/linux-*.efi $boot_part_name/EFI/void/void-signed-uki.efi" \
	> /mnt/etc/kernel.d/post-install/99-uefi-boot
	chmod +x /mnt/etc/kernel.d/post-install/99-uefi-boot


	echo -e 'CREATE_UEFI_BUNDLES=yes' >> /mnt/etc/default/dracut-uefi-hook

	efibootmgr -c -d $disk -p 1 -L "Void Linux uki OLD" -l "\EFI\void\void-signed-uki-old.efi"
	efibootmgr -c -d $disk -p 1 -L "Void Linux uki" -l "\EFI\void\void-signed-uki.efi"
fi

if [[ $bm == "uki" && $fs_type != "btrfs" ]]; then
	echo 'kernel_cmdline="loglevel=3 rd.luks.name='$luks_root_uuid'=crypt rd.lvm.vg='$hostname' root=/dev/'$hostname'/root rd.luks.allow-discards apparmor=1 security=apparmor"' >> /mnt/etc/dracut.conf.d/10-boot.conf
elif [[ $bm == "uki" && $fs_type == "btrfs" ]]; then
	echo 'kernel_cmdline="loglevel=3 root=UUID='$ROOT_UUID' apparmor=1 security=apparmor"' >> /mnt/etc/dracut.conf.d/10-boot.conf
fi


#GRUB
if [[ $bm == "grub" && $uefi == "true" ]]; then
    $crm grub-install --target=x86_64-efi --efi-directory=$boot_part_name --bootloader-id=Void #	--disable-shim-lock --modules="tpm"

elif [[ $bm == "grub" && $uefi == "false" ]]; then
	$crm grub-install $disk
fi

if [[ $bm == "grub" && $encryption == 0 && $secure_boot == 0 ]]; then
	echo "GRUB_ENABLE_CRYPTODISK=y" >> /mnt/etc/default/grub
elif [[ $bm == "grub" && $encryption == 0 && $secure_boot == 1 ]]; then
	echo "GRUB_ENABLE_CRYPTODISK=y" >> /mnt/etc/default/grub
	dd bs=1 count=64 if=/dev/urandom of=/mnt/boot/volume.key
	$crm chmod 000 /boot/volume.key
	$crm chmod -R g-rwx,o-rwx /boot
	echo 'install_items+=" /boot/volume.key /etc/crypttab "' >> /mnt/etc/dracut.conf.d/10-boot.conf
fi

if [[ $bm == "grub" && $encryption == 0 && $secure_boot == 1 && $uefi == "true" ]]; then
		echo $luks_pw | cryptsetup luksAddKey $disk'2' /mnt/boot/volume.key
elif [[ $bm == "grub" && $encryption == 0 && $secure_boot == 1 && $uefi == "false" ]]; then
		echo $luks_pw | cryptsetup luksAddKey $disk'1' /mnt/boot/volume.key
fi

if [[ $bm == "grub" && $encryption == 0 && $secure_boot == 1 && $fs_type != "btrfs" ]]; then
		echo "crypt UUID=$luks_uuid /boot/volume.key luks" >> /mnt/etc/crypttab
		echo 'GRUB_CMDLINE_LINUX="rd.lvm.vg='$hostname' rd.luks.uuid='$luks_uuid' apparmor=1 security=apparmor"' >> /mnt/etc/default/grub
elif [[ $bm == "grub" && $encryption == 0 && $secure_boot == 1 && $fs_type == "btrfs" ]]; then
		echo 'GRUB_BTRFS_ENABLE_CRYPTODISK="true"' >> /mnt/etc/default/grub-btrfs/config
	    echo "crypt UUID=$ROOT_UUID /boot/volume.key luks" >> /mnt/etc/crypttab
		echo 'GRUB_CMDLINE_LINUX="root=UUID='$ROOT_UUID' apparmor=1 security=apparmor"' >> /mnt/etc/default/grub
fi

if [[ $bm == "grub" && $uefi == "false" && $encryption == 0  && $fs_type != "btrfs" ]]; then
	echo "GRUB_ENABLE_CRYPTODISK=y" >> /mnt/etc/default/grub
    echo 'GRUB_CMDLINE_LINUX="rd.lvm.vg='$hostname' rd.luks.uuid='$luks_uuid' apparmor=1 security=apparmor"' >> /mnt/etc/default/grub
fi


if [[ $bm == "grub" && $uefi == "true" && $secure_boot == 0 ]] ; then

	 cmdline="root=UUID=$ROOT_UUID rw quiet bgrt_disable apparmor=1 security=apparmor"
	 mkdir -p /mnt/etc/kernel
	 echo $cmdline > /mnt/etc/kernel/cmdline


#grub menu for uki
echo -e "menuentry 'Void Linux with UKI (Secure Boot)' --class void --class gnu-linux --class gnu --class os {
    insmod part_gpt
    insmod fat
    search --no-floppy --fs-uuid --set=root $boot_uuid
    chainloader /EFI/void/void-signed-uki.efi
}" >> /mnt/etc/grub.d/40_custom


sed -i 's/^GRUB_DEFAULT=0/GRUB_DEFAULT="Void Linux with UKI (Secure Boot)"/' /mnt/etc/default/grub

fi

if [[ $bm == "grub" ]]; then
	$crm grub-mkconfig -o /boot/grub/grub.cfg
fi

}

secboot()
{
#secure boot
if [[ $secure_boot == 0 ]]; then

	$crm sbctl create-keys
	$crm sbctl enroll-keys -i -m

	echo "SBSIGN_EFI_KERNEL=1" >> /mnt/etc/default/sbsigntool-kernel-hook
	echo "EFI_CERT_FILE=/var/lib/sbctl/keys/db/db.pem" >> /mnt/etc/default/sbsigntool-kernel-hook
	echo "EFI_KEY_FILE=/var/lib/sbctl/keys/db/db.key" >> /mnt/etc/default/sbsigntool-kernel-hook

fi

